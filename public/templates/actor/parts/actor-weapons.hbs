<ol class='item-container'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize 'Name'}}</div>
    <div class='item-controls'>
      <a class='item-control item-create' data-action="createItem" title='Create item' data-type='weapon'>
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type='weapon'}}
      </a>
    </div>
  </li>
  {{#each weaponsList as |item id|}}
  <li class='item item-row' data-item-id='{{item._id}}'>
    <div class='item-name'>
      <div class='item-image'>
        <a class='rollable' data-action="rollable" data-roll-type='item'>
          <img src='{{item.img}}' title='{{item.name}}' width='24' height='24' />
        </a>
      </div>
      <h4 class="item-label rollable" data-action="rollable" data-roll-type="item">{{item.name}}</h4>
    </div>
    <div class="item-equip-controls">
      {{#if ../showEquipState}}
      {{> "systems/abbrew/templates/item/item/templates/item-equip-state-changes.hbs" equipStates =
      item.system.validEquipStates}}
    </div>
    {{/if}}
    <div class="item-context-controls">
      {{#gm}}
      <label>
        <input type="checkbox" class="anatomy-revealed" name="system.revealed.isRevealed" {{ checked
          item.system.revealed.isRevealed }}>
        {{#if item.system.revealed.isRevealed}}
        <span class="icon icon-anatomy-revealed-c" />
        {{else}}
        <span class="icon icon-anatomy-revealed-u" />
        {{/if}}
      </label>
      {{/gm}}
    </div>
    <div class='item-controls'>
      <a class='item-control item-edit' data-action="editItem" title='{{localize "DOCUMENT.Edit" type=' weapon'}}'>
        <i class='fas fa-edit'></i>
      </a>
      <a class='item-control item-delete' data-action="deleteItem" title='{{localize "DOCUMENT.Delete" type='
        weapon'}}'>
        <i class='fas fa-trash'></i>
      </a>
    </div>
  </li>
  {{/each}}
</ol>