<div class="revealed-details">
    <div class='revealed-name'>
        <div class='revealed-image'>
            <a class='rollable' data-action="rollable" data-roll-type='item'>
                <img src='{{item.img}}' title='{{item.name}}' width='24' height='24' />
            </a>
        </div>
        {{#if item.system.revealed.isRevealed}}
        <label>{{item.name}}</label>
        {{else}}
        <label>{{item.system.name.base}}</label>
        {{/if}}
        {{#gm}}
        <label>
            <input type="checkbox" class="anatomy-revealed" name="system.revealed.isRevealed" {{ checked
                item.system.revealed.isRevealed }} data-action="toggleRevealed">
            {{#if item.system.revealed.isRevealed}}
            <span class="icon icon-anatomy-revealed-c" />
            {{else}}
            <span class="icon icon-anatomy-revealed-u" />
            {{/if}}
        </label>
        {{/gm}}
        {{#unless item.system.revealed.isRevealed}}
        <div class='item-controls'>
            {{#gm}}
            <a class='item-control item-study' data-action="studyItem" title='{{localize "DOCUMENT.Study" type='
                equipment'}}'>
                <i class="fa-solid fa-magnifying-glass"></i>
            </a>
            <a class='item-control item-edit' data-action="editItem" title='{{localize "DOCUMENT.Edit" type='
                equipment'}}'>
                <i class='fas fa-edit'></i>
            </a>
            {{/gm}}
        </div>
        {{/unless}}
    </div>
</div>