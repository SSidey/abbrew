<h3>Anatomy</h3>
<ol style="list-style:none;padding-left: 0px;">
    {{#each playerRevealed.anatomy as |anatomy|}}
    <li class="revealed-item item" data-item-id="{{anatomy.item._id}}">
        {{> "systems/abbrew/templates/actor/parts/actor-visible-item-internal.hbs" item=anatomy.item}}
        <ol style="list-style:none;" class="anatomy-revealed-weapons">
            {{#each anatomy.grantedWeapons as |weapon|}}
            {{> "systems/abbrew/templates/actor/parts/actor-visible-item.hbs" item=weapon}}
            {{/each}}
        </ol>
        <ol style="list-style:none;" class="anatomy-revealed-skills">
            {{#each anatomy.grantedSkills as |skill|}}
            {{> "systems/abbrew/templates/actor/parts/actor-visible-item.hbs" item=skill}}
            {{/each}}
        </ol>
    </li>
    {{/each}}
</ol>
<h3>Armour</h3>
<ol style="list-style:none;padding-left: 0px;">
    {{#each playerRevealed.armour as |armour|}}
    {{> "systems/abbrew/templates/actor/parts/actor-visible-item.hbs" item=armour}}
    {{/each}}
    {{#each playerVisible.armour as |armour|}}
    {{> "systems/abbrew/templates/actor/parts/actor-visible-item.hbs" item=armour}}
    {{/each}}
</ol>
<h3>Weapons</h3>
<ol style="list-style:none;padding-left: 0px;">
    {{#each playerRevealed.weapons as |weapon|}}
    {{> "systems/abbrew/templates/actor/parts/actor-visible-item.hbs" item=weapon}}
    {{/each}}
    {{#each playerVisible.weapons as |weapon|}}
    {{> "systems/abbrew/templates/actor/parts/actor-visible-item.hbs" item=weapon}}
    {{/each}}
</ol>