<form class="abbrew" autocomplete="off">
    <div class="browser">
        <div class="browser-header">
        </div>
        <div class="browser-form">
            <div class="browser-search">
                <div>
                    <h3>Skills</h3>
                    <h4>Traits</h4>
                    <input type="text" class="search-filter" name="traits" data-dtype="String" />
                    <h4>Min Rank</h4>
                    <input type="number" min="1" max="10" step="1">
                    <h4>Max Rank</h4>
                    <input type="number" min="1" max="10" step="1">
                </div>
            </div>
            <div class="browser-results">
                <ol style="list-style:none; padding-left:0px; overflow:scroll">
                    {{#each skills as |skill|}}
                    <li class="skill" data-id="{{skill.id}}" data-roles='{{skill.jsonRoles}}'
                        data-action="renderSkillSheet">
                        <div class="image-container"><img src="{{skill.img}}" /></div>
                        <div class="name"><span>{{skill.name}}</span></div>
                        <div class="description"><span>{{skill.description}}</span></div>
                        <a class="item-control" data-action="renderSkillSheet" title="Open">
                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                        </a>
                    </li>
                    {{/each}}
                </ol>
            </div>
        </div>
    </div>
</form>