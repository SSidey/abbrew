<header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" title="{{item.name}}" {{#if editable}} data-action="editImage"
        data-edit="img" {{else}} data-action="showIcon" {{/if}} />
    <div class="header-fields">
        <h1 class="charname">{{formInput item.schema.fields.name value=item.name placeholder="Name"}}</h1>
        {{#if (isGM)}}
        {{formGroup system.schema.fields.name.fields.base value=system.name.base localize=true
        classes="resource-label"}}
        {{/if}}
        <div class="grid grid-2col">
            <div class="resource">
                {{formGroup system.schema.fields.meta.fields.tier value=system.meta.tier classes="bold-label"}}
            </div>
            <div class="resource">
                {{formGroup system.schema.fields.meta.fields.quality value=system.meta.quality classes="bold-label"}}
            </div>
        </div>
        <div class="grid grid-3col">
            <div class="resource">
                {{formGroup system.schema.fields.quantity value=system.quantity classes="bold-label"}}
            </div>
            <div class="resource">
                {{formGroup system.schema.fields.heft value=system.heft classes="bold-label"}}
            </div>
            <div class="resource">
                {{formGroup system.schema.fields.complexity value=system.complexity classes="bold-label"}}
            </div>
        </div>
    </div>
</header>