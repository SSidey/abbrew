<header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="header-fields">
        <h1 class="charname">{{formInput item.schema.fields.name value=item.name placeholder="Name"}}</h1>
        {{formGroup system.schema.fields.rank value=system.rank localize=true}}
    </div>
</header>