{{formGroup system.schema.fields.activation.fields.activateWith value=system.activation.activateWith
dataset=datasets.skillDrop localize=true classes="activate-with skill-span-2" }}
{{formGroup system.schema.fields.activation.fields.andDeactivateWith value=system.activation.andDeactivateWith
localize=true }}
{{formGroup system.schema.fields.activation.fields.deactivateWith value=system.activation.deactivateWith
dataset=datasets.skillDrop localize=true classes="deactivate-with skill-span-2" }}
