<div class="skill-element-max-input">
    {{formGroup system.schema.fields.activation.fields.requiredActiveSkills value=system.activation.requiredActiveSkills
    dataset=datasets.skillDrop localize=true classes="required-active-skills skill-span-2" }}
    {{formGroup system.schema.fields.skillModifiers.fields.synergy
    value=system.skillModifiers.synergy localize=true dataset=datasets.skillDrop classes="skill-span-2"}}
    {{formGroup system.schema.fields.skillModifiers.fields.synergyTraitFilter.fields.raw
    value=system.skillModifiers.synergyTraitFilter.raw localize=true classes="skill-span-2"}}
    {{formGroup system.schema.fields.skillModifiers.fields.discord
    value=system.skillModifiers.discord localize=true dataset=datasets.skillDrop classes="skill-span-2"}}
    {{formGroup system.schema.fields.skillModifiers.fields.blockSilently value=system.skillModifiers.blockSilently
    classes="skill-span-2"}}
    {{formGroup system.schema.fields.grantedBy.fields.actor value=system.grantedBy.actor localize=true
    classes="skill-span-2"}}
    {{formGroup system.schema.fields.grantedBy.fields.token value=system.grantedBy.token localize=true
    classes="skill-span-2"}}
    {{formGroup system.schema.fields.grantedBy.fields.item value=system.grantedBy.item localize=true
    classes="skill-span-2"}}
    <label class="slide-toggle roboto-upper">
        <input type="checkbox" class="action-activatable" name="system.skillModifiers.isActorGrantTriggerRequired" {{
            checked system.skillModifiers.isActorGrantTriggerRequired }}>
        <span>Is Actor Trigger Required</span>
        {{#if system.skillModifiers.isActorGrantTriggerRequired}}
        <i class="fa fa-toggle-on"></i>
        {{else}}
        <i class="fa fa-toggle-off"></i>
        {{/if}}
    </label>
    <label class="slide-toggle roboto-upper">
        <input type="checkbox" class="action-activatable" name="system.skillModifiers.isItemGrantTriggerRequired" {{
            checked system.skillModifiers.isItemGrantTriggerRequired }}>
        <span>Is Item Trigger Required</span>
        {{#if system.skillModifiers.isItemGrantTriggerRequired}}
        <i class="fa fa-toggle-on"></i>
        {{else}}
        <i class="fa fa-toggle-off"></i>
        {{/if}}
    </label>
</div>
<div>
    <h3>Granted Skills</h3>
    <ol class="skill-deck-skills" data-collection-name="granted">
        {{#each system.skills.granted as |skill id|}}
        <li class="skill-deck-skill" data-id="{{id}}" data-item-id="{{{skill.id}}}" data-source-id="{{skill.sourceId}}"
            data-action="renderItemSheet">
            <div class="skill-deck-summary">
                <div class="image-container"><img src="{{skill.image}}" /></div>
                <div class="name"><span>{{skill.name}}</span></div>
                <a class='item-control skill-delete' data-action="deleteSkill"
                    title='{{localize "DOCUMENT.Delete" type=' skill'}}'>
                    <i class='fas fa-trash'></i>
                </a>
            </div>
        </li>
        {{/each}}
        <li class="empty-drop-list-element">
            <span>+ Skill</span>
        </li>
    </ol>
</div>
<div>
    <h3>Paired Skills</h3>
    <ol class="skill-deck-skills" data-collection-name="paired">
        {{#each system.skills.paired as |skill id|}}
