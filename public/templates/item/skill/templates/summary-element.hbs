<h3>{{header}}</h3>
<ol class="skill-deck-skills" data-collection-name="{{collection}}">
    {{#each collectionSkills as |skill id|}}
    <li class="skill-deck-skill" data-id="{{id}}" data-item-id="{{{skill.id}}}" data-source-id="{{skill.sourceId}}"
        data-action="renderItemSheet">
        <div class="skill-deck-summary">
            <div class="image-container"><img src="{{skill.image}}" /></div>
            <div class="name"><span>{{skill.name}}</span></div>
            <a class='item-control skill-delete' data-action="deleteSkill" title='{{localize "DOCUMENT.Delete" type='
                skill'}}'>
                <i class='fas fa-trash'></i>
            </a>
        </div>
    </li>
    {{/each}}
    {{#if editable}}
    <li class="empty-drop-list-element">
        <span>+ Skill</span>
    </li>
    {{/if}}
</ol>