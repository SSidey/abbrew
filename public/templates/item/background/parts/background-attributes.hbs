<div class="skill-deck-attributes">
    {{#gm}}
    <div class="attributes flexcol">
        {{#each system.attributes as |attribute key|}}
        <div class="attribute flexrow flex-group-center">
            <label class="slide-toggle roboto-upper">
                <input type="checkbox" class="skill-deck-attribute-is-enabled"
                    name="system.attributes.{{key}}.isEnabled" {{ checked attribute.isEnabled }}>
                <span>{{attribute.label}}</span>
                {{#if attribute.isEnabled}}
                <i class="fa fa-toggle-on"></i>
                {{else}}
                <i class="fa fa-toggle-off"></i>
                {{/if}}
            </label>
        </div>
        {{/each}}
    </div>
    {{/gm}}
    <div class="skill-deck-attributes-column">
        {{#each system.attributes as |attribute key|}}
        {{#if attribute.isEnabled}}
        <div class="attribute flexrow flex-group-center">
            <label for="system.attributes.{{key}}.value" class="resource-label rollable flexlarge align-left"
                data-action="rollable">{{attribute.label}}</label>
            <input type="text" name="system.attributes.{{key}}.value" value="{{attribute.value}}" min=0 max=9
                data-dtype="Number" />
        </div>
        {{/if}}
        {{/each}}
    </div>
</div>
<h3>Creature Form</h3>
{{#if system.creatureForm.id}}
<div class="skill-deck-skill" data-action="renderItemSheet" data-item-id="{{system.creatureForm.id}}"
    data-source-id="{{system.creatureForm.sourceId}}">
    <div class="skill-deck-summary">
        <div class="image-container"><img src="{{system.creatureForm.image}}" /></div>
        <div class="name"><span>{{system.creatureForm.name}}</span></div>
        <a class='item-control creature-form-delete' data-action="deleteCreatureForm"
            title='{{localize "DOCUMENT.Delete" type=' creatureForm'}}'>
            <i class='fas fa-trash'></i>
        </a>
    </div>
</div>
{{else}}
<div class="empty-summary-element creature-form">
    <span>+ Creature Form</span>
</div>
{{/if}}
<div>
    <h3>Skills</h3>
    <ol class="skill-deck-skills">
        {{#each system.skills.granted as |skill id|}}
        <li class="skill-deck-skill" data-action="renderItemSheet" data-id="{{id}}" data-item-id="{{skill.id}}"
            data-source-id="{{skill.sourceId}}">
            <div class="skill-deck-summary">
                <div class="image-container"><img src="{{skill.image}}" /></div>
                <div class="name"><span>{{skill.name}}</span></div>
                <a class='item-control skill-delete' data-action="deleteSkill"
                    title='{{localize "DOCUMENT.Delete" type=' skill'}}'>
                    <i class='fas fa-trash'></i>
                </a>
            </div>
        </li>
        {{/each}}
        <li class="empty-drop-list-element">
            <span>+ Skill</span>
        </li>
    </ol>
</div>