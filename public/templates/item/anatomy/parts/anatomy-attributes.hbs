{{>"systems/abbrew/templates/item/item/parts/item-reveal-skills.hbs"}}
<div class="resource">
    <div class="grid grid-4col">
        <div class="grid-span-2">
            <label class="resource-label">Parts</label>
            <input type="text" name="system.parts" value="{{system.parts}}" data-dtype="String" />
        </div>
        <div class="grid-span-1">
            <label class="resource-label">Hands</label>
            <input type="text" name="system.hands" value="{{system.hands}}" data-dtype="Number" />
        </div>
        <div class="grid-span-1">
            <h3>Speed</h3>
            {{#each system.speed as |speed key|}}
            <label class="resource-label">{{speed.label}} Speed Mod</label>
            <input type="text" name="system.speed.{{key}}.value" value="{{speed.value}}" data-dtype="Number" />
            {{/each}}
        </div>
    </div>
</div>
{{> "systems/abbrew/templates/item/item/templates/item-defenses.hbs" showEquipType=false}}
<div>
    <h3>Natural Weapons</h3>
    <ol class="anatomy-weapon-list">
        {{#each system.naturalWeapons as |weapon id|}}
        <li class="anatomy-weapon" data-id="{{id}}" data-item-id="{{weapon.id}}" data-source-id="{{weapon.sourceId}}">
            <div class="anatomy-weapon-summary">
                <div class="image-container" data-action="renderWeaponSheet"><img src="{{weapon.image}}" /></div>
                <div class="name" data-action="renderWeaponSheet"><span>{{weapon.name}}</span></div>
                <a class='item-control anatomy-weapon-delete' data-action="deleteAnatomyWeapon"
                    title='{{localize "DOCUMENT.Delete" type="weapon"}}'>
                    <i class='fas fa-trash'></i>
                </a>
            </div>
        </li>
        {{/each}}
        <li class="empty-drop-list-element">
            <span>+ Natural Weapon</span>
        </li>
    </ol>
</div>
<div>
    <h3>Skills</h3>
    <ol class="skill-deck-skills">
        {{#each system.skills.granted as |skill id|}}
        <li class="skill-deck-skill" data-id="{{id}}" data-item-id="{{skill.id}}" data-source-id="{{skill.sourceId}}">
            <div class="skill-deck-summary">
                <div class="image-container" data-action="renderItemSheet"><img src="{{skill.image}}" /></div>
                <div class="name" data-action="renderItemSheet"><span>{{skill.name}}</span></div>
                <a class='item-control skill-delete' data-action="skillDelete"
                    title='{{localize "DOCUMENT.Delete" type=' skill'}}'>
                    <i class='fas fa-trash'></i>
                </a>
            </div>
        </li>
        {{/each}}
        <li class="empty-drop-list-element">
            <span>+ Skill</span>
        </li>
    </ol>
</div>