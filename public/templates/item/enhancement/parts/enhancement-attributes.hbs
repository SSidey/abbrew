<div class="grid-2col">
    <div class="enhancement-target-type">
        <label>Target Type</label>
        <select name="system.targetType">
            {{selectOptions config.enhancementTargetTypes selected=system.targetType
            localize=true}}
        </select>
    </div>
    <div class="enhancement-type">
        <label>Type</label>
        <select name="system.enhancementType">
            {{selectOptions config.enhancementTypes selected=system.enhancementType blank=""
            localize=true}}
        </select>
    </div>
</div>
<div class="target">
    <label>Target</label>
    <input type="text" name="system.target" data-target-uuid="system.target.uuid" value="{{system.target.name}}"
        readonly>
</div>
<div class="cost">
    <label>Cost</label>
    <input type="text" name="system.cost" value="{{system.cost}}">
</div>
<div>
    <h3>Duration</h3>
    <select name="system.duration.precision">
        {{selectOptions config.durations selected=system.duration.precision localize=true}}
    </select>
    <input type="text" name="system.duration.value" value="{{system.duration.value}}" data-dtype="String" />
    <label class="slide-toggle roboto-upper">
        <input type="checkbox" class="action-activatable" name="system.duration.expireOnStartOfTurn" {{ checked
            system.duration.expireOnStartOfTurn }}>
        {{#if system.duration.expireOnStartOfTurn}}
        <span>Expires on start of turn</span>
        {{else}}
        <span>Expires at end of turn</span>
        {{/if}}
        {{#if system.duration.expireOnStartOfTurn}}
        <i class="fa fa-toggle-on"></i>
        {{else}}
        <i class="fa fa-toggle-off"></i>
        {{/if}}
    </label>
</div>
<div>
    <h3>Trait Filter</h3>
    <input type="text" class="trait-filter" name="system.traitFilter.raw" value="{{system.traitFilter.raw}}"
        data-dtype="String" />
</div>
<div>
    <h3>Modifications</h3>
    <ol class="enhancement-modification-list" style="list-style: none; padding-left: 0px;">
        {{#each system.modifications as |modification i|}}
        <li class="item enhancement-modification" data-id="{{i}}">
            <div>
                <select name="system.modifications.{{i}}.operator">
                    {{selectOptions ../config.enhancementOperators selected=modification.operator
                    localize=true}}
                </select>
            </div>
            <div>
                <input type="text" name="system.modifications.{{i}}.path" value="{{modification.path}}"
                    placeholder="Path e.g. system.attackProfiles" data-dtype="String" />
            </div>
            <div>
                <input type="text" name="system.modifications.{{i}}.filterPath"
                    placeholder="Filter Path e.g. attackType" value="{{modification.filterPath}}" data-dtype="String" />
            </div>
            <div>
                <input type="text" name="system.modifications.{{i}}.filterValue" placeholder="Filter Value e.g. arc"
                    value="{{modification.filterValue}}" data-dtype="String" />
            </div>
            <div>
                <input type="text" name="system.modifications.{{i}}.subPath" placeholder="Sub-Path e.g. damage"
                    value="{{modification.subPath}}" data-dtype="String" />
            </div>
            <div>
                <input type="text" name="system.modifications.{{i}}.subPathFilter" placeholder="Sub-Filter e.g. type"
                    value="{{modification.subPathFilter}}" data-dtype="String" />
            </div>
            <div>
                <input type="text" name="system.modifications.{{i}}.subPathFilterValue"
                    placeholder="Sub-Filter Value e.g. slashing" value="{{modification.subPathFilterValue}}"
                    data-dtype="String" />
            </div>
            <div>
                <input type="text" name="system.modifications.{{i}}.field" placeholder="Field e.g. value"
                    value="{{modification.field}}" data-dtype="String" />
            </div>
            <div>
                <select name="system.modifications.{{i}}.type">
                    {{selectOptions ../config.modifierPrefixes selected=modification.type
                    localize=true}}
                </select>
            </div>
            <div>
                <input type="text" name="system.modifications.{{i}}.value" value="{{modification.value}}"
                    placeholder="Value" data-dtype="String" />
            </div>
            <div>
                <input type="text" name="system.modifications.{{i}}.numerator" value="{{modification.numerator}}"
                    data-dtype="Number" />
            </div>
            <div>
                <input type="text" name="system.modifications.{{i}}.denominator" value="{{modification.denominator}}"
                    data-dtype="Number" />
            </div>
            <a class="modification-control remove-modification" data-action="onModificationAction"
                data-mode="remove-modification">
                <i class="fa-solid fa-minus"></i>
            </a>
        </li>
        {{/each}}
        <li class="modification add">
            <div class="form-group">
                <label>
                    <a class="modification-control" data-action="onModificationAction" data-mode="add-modification">
                        Add modification
                        <i class="fa-solid fa-plus"></i>
                    </a>
                </label>
            </div>
        </li>
    </ol>
</div>
<div>
    <h3>Skills</h3>
    <ol class="skill-deck-skills">
        {{#each system.skills.granted as |skill id|}}
        <li class="skill-deck-skill" data-id="{{id}}" data-item-id="{{skill.id}}" data-source-id="{{skill.sourceId}}">
            <div class="skill-deck-summary">
                <div class="image-container"><img src="{{skill.image}}" /></div>
                <div class="name"><span>{{skill.name}}</span></div>
                <a class='item-control skill-delete' data-action="deleteSkill"
                    title='{{localize "DOCUMENT.Delete" type=' skill'}}'>
                    <i class='fas fa-trash'></i>
                </a>
            </div>
        </li>
        {{/each}}
        <li class="empty-drop-list-element">
            <span>+ Skill</span>
        </li>
    </ol>
</div>