<div class="abbrew chat-message chat-card flexcol " data-actor-id="{{actor._id}}" data-token-id="{{tokenId}}"
    data-message-id="{{messageId}}">
    <header>
        {{#if finisher}}
        <h3 class="finisher-name">{{localize finisherType}} {{finisherCost}}</h3>
        {{else}}
        <h3 class="finisher-name">No Finisher</h3>
        {{/if}}
    </header>

    <div class="message-content">
        {{#if finisher}}
        <div>{{{finisher.text}}}</div>
        <div>
            <h4>Wounds</h4>
            <ol style="list-style:none;padding-left:0px;">
                {{#each wounds as |wound|}}
                <span><img class="wound-image" src="systems/abbrew/assets/icons/wounds/{{wound.type}}.webp"
                        alt="{{wound.type}} {{wound.value}}"> {{wound.name}} {{wound.value}}</span>
                {{/each}}
            </ol>
        </div>
        {{else}}
        <div>Unable to perform finisher.</div>
        {{/if}}
    </div>
</div>